# EchoVoice - example environment configuration.
# Set these in the environment (or your deployment host) before running
# Build_Config_Scripts/run_backend.ps1.

# Path to the fine-tuned checkpoint saved by trainer.save_model()
# (see Data_Schema / export_checkpoint.py). If unset or the folder is empty,
# app.py falls back to facebook/hubert-large-ls960-ft - those weights were
# NOT trained on children's speech, so transcripts will be noticeably worse.
ECHOVOICE_MODEL_DIR=C:\path\to\hubert-bcs

# Comma-separated list of allowed CORS origins for the frontend.
# Use "*" only for local development.
ECHOVOICE_CORS_ORIGINS=http://localhost:5500,https://your-frontend-domain.com

# Backend listen port (default 8000). GPU strongly recommended for inference.
PORT=8000